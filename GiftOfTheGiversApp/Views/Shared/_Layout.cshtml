@{
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    var currentAction = ViewContext.RouteData.Values["action"] as string;
    string NavActive(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : "";
}
<!DOCTYPE html>
<html lang="en-ZA">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#041f13" />
    <title>@(ViewData["Title"] ?? "Home") · Gift of the Givers</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GiftOfTheGiversApp.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="gotg-frame">
        <header class="gotg-header">
            <nav class="navbar navbar-expand-lg navbar-dark gotg-nav">
                <div class="container">
                    <a class="navbar-brand gotg-brand" asp-controller="Home" asp-action="Index">
                        <span class="gotg-brand-mark"><i class="bi bi-heart-fill"></i></span>
                        Gift of the Givers
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse" id="mainNav">
                        <ul class="navbar-nav mx-auto gap-lg-1">
                            <li class="nav-item"><a class="nav-link @NavActive("Home", "Index")" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link @NavActive("Incidents")" asp-controller="Incidents" asp-action="Index">Incidents</a></li>
                            <li class="nav-item"><a class="nav-link @NavActive("Donations", "Create")" asp-controller="Donations" asp-action="Create">Donate</a></li>
                            <li class="nav-item"><a class="nav-link @NavActive("Donations", "TaxCertificate")" asp-controller="Donations" asp-action="TaxCertificate">Tax certificates</a></li>
                            <li class="nav-item"><a class="nav-link @NavActive("Volunteers", "Create")" asp-controller="Volunteers" asp-action="Create">Volunteer</a></li>
                            <li class="nav-item"><a class="nav-link @NavActive("Home", "Transparency")" asp-controller="Home" asp-action="Transparency">Public totals</a></li>
                        </ul>
                        <div class="d-flex align-items-center gap-2 gotg-nav-actions">
                            <a class="btn btn-warning btn-sm" asp-controller="Operations" asp-action="Index"><i class="bi bi-grid-1x2-fill me-1"></i>Staff desk</a>
                            <partial name="_LoginPartial" />
                        </div>
                    </div>
                </div>
            </nav>
        </header>

        <div class="gotg-frame-banner">
            @if (TempData["Status"] is string status)
            {
                <div class="container">
                    <div class="gotg-toast fade-up" role="alert">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@status</span>
                    </div>
                </div>
            }
        </div>

        <main role="main" class="gotg-frame-main">
            @RenderBody()
        </main>

        <footer class="gotg-footer">
            <div class="container pt-5 pb-4">
                <div class="row g-4">
                    <div class="col-lg-5">
                        <a class="gotg-brand text-white fs-5 mb-3" asp-controller="Home" asp-action="Index">
                            <span class="gotg-brand-mark"><i class="bi bi-heart-fill"></i></span>
                            Gift of the Givers
                        </a>
                        <p class="small mb-0 mt-3" style="max-width: 24rem;">Largest disaster response NGO of African origin on the African continent. Prototype for APPR6312 Part 1, Section C.</p>
                    </div>
                    <div class="col-sm-6 col-lg-4 small">
                        <p class="footer-heading">National call centre</p>
                        <p class="mb-1"><i class="bi bi-telephone me-2"></i>Toll free: 0800 786 911</p>
                        <p class="mb-1"><i class="bi bi-envelope me-2"></i>info@giftofthegivers.org</p>
                        <p class="mb-0"><i class="bi bi-patch-check me-2"></i>NPO 032-031 · PBO 930018993</p>
                    </div>
                    <div class="col-sm-6 col-lg-3 small">
                        <p class="footer-heading">Public access</p>
                        <a class="d-block mb-1" asp-controller="Home" asp-action="Transparency">Incoming donation totals</a>
                        <a class="d-block mb-1" asp-controller="Incidents" asp-action="Index">Active incidents</a>
                        <a class="d-block mb-1" asp-controller="Donations" asp-action="TaxCertificate">Tax certificates</a>
                        <a class="d-block" asp-area="Identity" asp-page="/Account/Login">Staff sign-in</a>
                    </div>
                </div>
                <div class="footer-bottom mt-5 pt-4 d-flex flex-wrap justify-content-between gap-2">
                    <span>© @DateTime.Now.Year Gift of the Givers Foundation</span>
                    <span>Best among people are those who benefit mankind</span>
                </div>
            </div>
        </footer>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
