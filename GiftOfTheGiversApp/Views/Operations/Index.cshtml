@{
    ViewData["Title"] = "Operations desk";
    var tiles = new (string Controller, string Action, string Title, string Text, string Icon, string Tone)[]
    {
        ("Incidents", "Create", "Log a disaster", "Start date, location, description and required aid.", "bi-plus-circle", "rose"),
        ("Donations", "Index", "Review donations", "Named and anonymous money and goods gifts.", "bi-receipt", "sand"),
        ("Categories", "Index", "Goods categories", "Add new categories beyond food, water and clothing.", "bi-tags", ""),
        ("Volunteers", "Index", "Volunteers", "Applications waiting for a field call-up.", "bi-people", "sky"),
        ("Incidents", "Index", "Close an incident", "Mark a disaster closed when the response ends.", "bi-check2-circle", "")
    };
}

<section class="page-hero">
    <div class="container">
        <span class="gotg-eyebrow"><i class="bi bi-person-check"></i>Staff workspace</span>
        <h1>Operations desk</h1>
        <p>Signed in as @User.Identity?.Name. Capture incidents, review incoming gifts and define new goods categories.</p>
    </div>
</section>

<div class="container page-body">
    <div class="row g-3 mt-2">
        <div class="col-6 col-lg-3">
            <div class="metric-card">
                <span class="icon-chip sand"><i class="bi bi-cash-coin"></i></span>
                <div class="metric-label">Money in</div>
                <div class="metric-value">R @(((decimal)ViewBag.MoneyTotal).ToString("N0"))</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="metric-card">
                <span class="icon-chip"><i class="bi bi-box-seam"></i></span>
                <div class="metric-label">Goods items</div>
                <div class="metric-value">@ViewBag.GoodsTotal</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="metric-card">
                <span class="icon-chip rose"><i class="bi bi-broadcast"></i></span>
                <div class="metric-label">Active incidents</div>
                <div class="metric-value">@ViewBag.ActiveIncidents</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="metric-card">
                <span class="icon-chip sky"><i class="bi bi-people"></i></span>
                <div class="metric-label">Volunteers</div>
                <div class="metric-value">@ViewBag.Volunteers</div>
            </div>
        </div>
    </div>

    <h2 class="section-title">Quick actions</h2>
    <div class="row g-3">
        @foreach (var tile in tiles)
        {
            <div class="col-md-6 col-lg-4">
                <a class="action-tile" asp-controller="@tile.Controller" asp-action="@tile.Action">
                    <span class="icon-chip @tile.Tone"><i class="bi @tile.Icon"></i></span>
                    <div>
                        <h2>@tile.Title</h2>
                        <p class="small text-muted mb-0">@tile.Text</p>
                    </div>
                    <i class="bi bi-arrow-right arrow"></i>
                </a>
            </div>
        }
    </div>
</div>
