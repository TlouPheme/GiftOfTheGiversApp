@model TransparencyViewModel
@{
    ViewData["Title"] = "Public totals";
}

<section class="page-hero">
    <div class="container">
        <span class="gotg-eyebrow"><i class="bi bi-unlock"></i>Open data</span>
        <h1>Public totals</h1>
        <p>Anyone can open this page without signing in. It shows total money received, total goods received, and currently active incidents.</p>
    </div>
</section>

<div class="container page-body">
    <div class="row g-3 mt-2">
        <div class="col-md-4">
            <div class="metric-card">
                <span class="icon-chip sand"><i class="bi bi-cash-coin"></i></span>
                <div class="metric-label">Money received</div>
                <div class="metric-value">R @Model.MoneyTotal.ToString("N0")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card">
                <span class="icon-chip"><i class="bi bi-box-seam"></i></span>
                <div class="metric-label">Goods received</div>
                <div class="metric-value">@Model.GoodsTotal.ToString("N0") <small>items</small></div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="metric-card">
                <span class="icon-chip rose"><i class="bi bi-broadcast"></i></span>
                <div class="metric-label">Active incidents</div>
                <div class="metric-value">@Model.ActiveIncidents.Count</div>
            </div>
        </div>
    </div>

    <h2 class="section-title">Goods by category</h2>
    <div class="row g-3">
        @foreach (var row in Model.GoodsByCategory)
        {
            <div class="col-md-6">
                <div class="card card-hover h-100">
                    <div class="card-body d-flex justify-content-between align-items-center gap-3">
                        <div class="min-w-0">
                            <div class="fw-semibold">@row.Name</div>
                            <div class="small text-muted">@row.Description</div>
                        </div>
                        <div class="text-end flex-shrink-0">
                            <div class="fs-4 fw-bold" style="letter-spacing: -.02em;">@row.ItemCount</div>
                            <div class="small text-muted">items</div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <h2 class="section-title">Currently active disasters <span class="count">@Model.ActiveIncidents.Count</span></h2>
    @if (!Model.ActiveIncidents.Any())
    {
        <div class="empty-state">No active incidents. When staff log a new disaster it will appear here.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var incident in Model.ActiveIncidents)
            {
                <div class="col-md-6">
                    <partial name="_IncidentCard" model="incident" />
                </div>
            }
        </div>
    }
</div>
