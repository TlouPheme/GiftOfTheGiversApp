@model HomeDashboardViewModel
@{
    ViewData["Title"] = "Home";
}

<section class="gotg-hero py-5">
    <div class="container">
        <div class="row g-4 align-items-start">
            <div class="col-lg-7">
                <p class="text-warning small text-uppercase mb-2">Best among people are those who benefit mankind</p>
                <h1 class="display-5 fw-semibold">Bring hope and restore dignity when disaster strikes.</h1>
                <p class="lead fs-6 opacity-75">
                    Gift of the Givers is the largest disaster response NGO of African origin on the African continent.
                    This operations desk lets the public give money or goods, register as volunteers, and see exactly
                    what is coming in — while authorised staff capture incidents and new aid categories.
                </p>
                <a class="btn btn-warning me-2" asp-controller="Donations" asp-action="Create">Donate now</a>
                <a class="btn btn-outline-light" asp-controller="Incidents" asp-action="Index">View active incidents</a>
            </div>
            <div class="col-lg-5">
                <div class="card shadow text-dark">
                    <div class="card-body">
                        <h2 class="h5 text-dark">Public incoming totals</h2>
                        <div class="stat-box mb-2">
                            <div class="small stat-label">Monetary donations received</div>
                            <div class="fs-4 fw-semibold stat-value">R @Model.MoneyTotal.ToString("N0")</div>
                        </div>
                        <div class="stat-box mb-2">
                            <div class="small stat-label">Goods items received</div>
                            <div class="fs-4 fw-semibold stat-value">@Model.GoodsTotal.ToString("N0") items</div>
                        </div>
                        <div class="stat-box">
                            <div class="small stat-label">Currently active incidents</div>
                            <div class="fs-4 fw-semibold stat-value">@Model.ActiveIncidentCount open responses</div>
                        </div>
                        <p class="small stat-label mt-3 mb-0">No login required. Anonymous gifts are included in the totals but the donor name is never shown.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="container py-5">
    <h2 class="h3">Primary focus areas</h2>
    <p class="text-muted">Every gift is tagged to the work Gift of the Givers already does in South Africa and across 47 countries.</p>
    <div class="row g-3">
        @{
            var areas = new (string Title, string Text)[]
            {
                ("Disaster response", "Rapid deployment when floods, drought, fire or conflict displace families."),
                ("Hunger alleviation", "Food parcels and feeding schemes that restore dignity, not just calories."),
                ("Water provision", "Tankers, boreholes and bottled water where municipal supply has failed."),
                ("Healthcare", "Clinics, medical supplies and patient support in crisis zones."),
                ("Education", "Stationery, bursaries and school feeding when a disaster closes classrooms."),
                ("Human development", "Skills, shelter and long-term recovery after the cameras leave.")
            };
        }
        @foreach (var area in areas)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h3 class="h6">@area.Title</h3>
                        <p class="small text-muted mb-0">@area.Text</p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<section class="container pb-5">
    <div class="d-flex justify-content-between align-items-end mb-3">
        <div>
            <h2 class="h3 mb-1">Active incidents</h2>
            <p class="text-muted mb-0">Anyone can see where teams are currently deployed.</p>
        </div>
        <a class="btn btn-outline-success" asp-controller="Incidents" asp-action="Index">All incidents</a>
    </div>
    @if (!Model.ActiveIncidents.Any())
    {
        <p class="text-muted">There are no active incidents on the desk right now.</p>
    }
    else
    {
        <div class="row g-3">
            @foreach (var incident in Model.ActiveIncidents)
            {
                <div class="col-md-6">
                    <partial name="_IncidentCard" model="incident" />
                </div>
            }
        </div>
    }
</section>
