@model IEnumerable<GoodsCategory>
@{
    ViewData["Title"] = "Goods categories";
    var create = (GoodsCategory)ViewBag.NewCategory;
}

<div class="container py-4">
    <h1>Goods categories</h1>
    <p class="text-muted">Food parcels, bottled water and clothing are pre-configured. Add extra categories here so donors can select them.</p>
    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h5">Define a new category</h2>
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label class="form-label">Category name</label>
                            <input name="Name" class="form-control" value="@create.Name" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Description</label>
                            <textarea name="Description" class="form-control">@create.Description</textarea>
                        </div>
                        <button type="submit" class="btn btn-gotg">Add category</button>
                    </form>
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            @foreach (var category in Model)
            {
                <div class="card mb-2">
                    <div class="card-body">
                        <div class="fw-semibold">
                            @category.Name
                            @if (category.IsPredefined)
                            {
                                <span class="badge text-bg-light border">pre-configured</span>
                            }
                        </div>
                        <div class="small text-muted">@category.Description</div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
