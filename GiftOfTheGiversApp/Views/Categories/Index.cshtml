@model IEnumerable<GoodsCategory>
@{
    ViewData["Title"] = "Goods categories";
    var create = (GoodsCategory)ViewBag.NewCategory;
}

<section class="page-hero">
    <div class="container">
        <a class="small text-white-50 text-decoration-none d-inline-block mb-3" asp-controller="Operations" asp-action="Index"><i class="bi bi-arrow-left me-1"></i>Operations desk</a>
        <h1>Goods categories</h1>
        <p>Food parcels, bottled water and clothing are pre-configured. Add extra categories here so donors can select them.</p>
    </div>
</section>

<div class="container page-body">
    <div class="row g-4 mt-2">
        <div class="col-lg-5">
            <div class="surface-card">
                <div class="form-section-title">
                    <span class="icon-chip"><i class="bi bi-tag"></i></span>
                    <h2>Define a new category</h2>
                </div>
                <form asp-action="Create" method="post">
                    <div class="mb-3">
                        <label class="form-label">Category name</label>
                        <input name="Name" class="form-control" value="@create.Name" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label">Description</label>
                        <textarea name="Description" class="form-control" rows="3">@create.Description</textarea>
                    </div>
                    <button type="submit" class="btn btn-gotg"><i class="bi bi-plus-lg me-1"></i>Add category</button>
                </form>
            </div>
        </div>
        <div class="col-lg-7">
            <div class="d-grid gap-2">
                @foreach (var category in Model)
                {
                    <div class="card card-hover">
                        <div class="card-body d-flex gap-3 align-items-start">
                            <span class="icon-chip @(category.IsPredefined ? "sand" : "")"><i class="bi @(category.IsPredefined ? "bi-pin-angle" : "bi-tag")"></i></span>
                            <div class="min-w-0">
                                <div class="fw-semibold">
                                    @category.Name
                                    @if (category.IsPredefined)
                                    {
                                        <span class="status-pill is-closed ms-1">pre-configured</span>
                                    }
                                </div>
                                <div class="small text-muted">@category.Description</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
