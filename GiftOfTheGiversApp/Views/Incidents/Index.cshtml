@model IEnumerable<Incident>
@{
    ViewData["Title"] = "Incidents";
    ViewData["ShowIncidentClose"] = true;
    var active = Model.Where(i => i.IsActive).ToList();
    var closed = Model.Where(i => !i.IsActive).ToList();
}

<section class="page-hero">
    <div class="container">
        <div class="incidents-toolbar">
            <div class="incidents-toolbar-copy">
                <span class="gotg-eyebrow"><span class="pulse"></span>Live response board</span>
                <h1>Incidents</h1>
                <p>The public list shows every disaster currently being served, plus closed incidents kept for accountability.</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a class="btn btn-warning incidents-toolbar-action" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Log a disaster</a>
            }
        </div>
    </div>
</section>

<div class="container page-body">
    <h2 class="section-title mt-5">Currently active <span class="count">@active.Count</span></h2>
    @if (!active.Any())
    {
        <div class="empty-state">No active incidents are on the board.</div>
    }
    else
    {
        <div class="row g-3 align-items-stretch">
            @foreach (var incident in active)
            {
                <div class="col-md-6">
                    <partial name="_IncidentCard" model="incident" />
                </div>
            }
        </div>
    }

    <h2 class="section-title">Closed incidents <span class="count">@closed.Count</span></h2>
    @if (!closed.Any())
    {
        <div class="empty-state">No closed incidents yet.</div>
    }
    else
    {
        <div class="row g-3 align-items-stretch">
            @foreach (var incident in closed)
            {
                <div class="col-md-6">
                    <partial name="_IncidentCard" model="incident" />
                </div>
            }
        </div>
    }
</div>
